 KINDRN(32) = 1
 LFIRST(32) = .FALSE.
 NMODLS(32) = 3000
 SETDT(32) = 2.5 ! fixed timestep (yr): HTIMER would otherwise reuse the stored one, far too long after a zero-timestep run
 XENV0A(32) = 0.708483
 ZENV0A(32) = 0.018804
 CMIXLA(32) = 1.852729
 END_DCEN(32) = 2.750e-05 ! Run stops when central D falls 1% (D birthline)

 LSTORE = .TRUE. ! If T, store model structures at specified points to the .store file. 
 LSTATM = .FALSE. ! If T, append an atmosphere to the stored model file.
 LSTENV = .FALSE. ! If T, append an envelope to the stored model file. If LSTENV and LSTATM = F, no information is output beyond the fitting point.
 LSTMOD = .TRUE. ! Set the same as LSTORE. May be redundant.
 LSTPHYS = .TRUE. ! If T, output microphysics (e.g. epsilon, kappa) to store file.
 LSTROT = .FALSE. ! If T, append rotation data to store file.
 NPRTMOD = 1000 ! Output detailed model structures every NPRTMOD models.
 NPRTPT = 1 ! Output details for every NPRTPT points (if 1000 points and NPRTPT=10, 100 lines are output).
 LSTPCH = .TRUE. ! If T, output details of the final model to the .store file.

 LTRACK = .TRUE. ! If T, global properties are always output to the .track file. This should almost always be on.
 ITRVER = 0 ! Toggle for different track file formats. 0 (one line per model) strongly recommended.
  
 LRWSH = .FALSE. ! If T, the short file retains only the details from the last model. This minimizes output file size.
 LCORR = .TRUE. ! If true, output verbose details on model convergence to .short.
  
 LPULSE = .FALSE. ! If T, generate pulsation output. LSTATM AND LSTENV are needed to get data for those regions (highly recommended if LPULSE is T)  
  
 LALEX06 = .TRUE. ! If T, use Ferguson+2005 molecular opacities (recommended)
 FALEX06 = "{YREC_INPUT}/opacity/molecular/alex06/alexmol06gs98.tab" ! Molecular opacity table path  
   
 LOPAL95 = .TRUE. ! If T, use atomic opacities in the OP/OPAL format (recommended).
 ZOPAL951 = 0.018777 ! Generate a surface mixture table with this Z. Speeds up models without diffusion.
 FLIV95 = "{YREC_INPUT}/opacity/atomic/legacy/opal95/GS98.OP17" ! Atomic opacity table path
  
 LPUREZ = .TRUE. 
 FPUREZ = "{YREC_INPUT}/opacity/atomic/lanl/PURECO.DBGLAOL" ! Pure Y/Z  opacity table path
  
! FFIRST = "{YREC_INPUT}/models/pms/gs98/p900gs98z0188.nmo" ! Starting model path.
 FFIRST = "{YREC_START}/dbl/m2200gs98z018804_Dbl.first" ! The last converged model is stored here.
 FLAST = "{YREC_OUTPUT}/m12000gs98z018804_Dbl.first" ! The last converged model is stored here.
 FMODPT = "{YREC_OUTPUT}/m12000gs98z018804_Dbl.full" ! No longer used.
 FSTOR = "{YREC_OUTPUT}/m12000gs98z018804_Dbl.store" ! Model snapshots during the run are stored here.
 FTRACK = "{YREC_OUTPUT}/m12000gs98z018804_Dbl.track" ! Global variables as a function of time are stored here.
 FSHORT = "{YREC_OUTPUT}/m12000gs98z018804_Dbl.short" ! Details about the numerics of the model run are stored here.
 FPMOD = "{YREC_OUTPUT}/m12000gs98z018804_Dbl.pmod" ! Pulsation output for the interior model.
 FPENV = "{YREC_OUTPUT}/m12000gs98z018804_Dbl.penv"! Pulsation output for the envelope model.
 FPATM = "{YREC_OUTPUT}/m12000gs98z018804_Dbl.atm" ! Pulsation output for the atmosphere model.
 FSNU = "{YREC_OUTPUT}/m12000gs98z018804_Dbl.snu" ! No longer used (formally, output if LSNU = T).
 FSCOMP = "{YREC_OUTPUT}/m12000gs98z018804_Dbl.excomp" ! No longer used (light elements vs. time, now included in track file)
  
 FOPALE06 = "{YREC_INPUT}/eos/opal2006/EOSOPAL06Z0.018776" ! OPAL 2006 EoS table path.
 FcondOpacP = "{YREC_INPUT}/opacity/conductive/potekhin/condall06.d" ! Conductive opacity table path.
 FATM = "{YREC_INPUT}/atmos/kurucz/atmk1990p00.tab" ! Model atmosphere look-up table for Kurucz and Kurucz/Castelli.
 FALLARD = "{YREC_INPUT}/atmos/allard/Nextgen2.all" ! Allard model atmosphere look-up table (solar Z only).
 FSCVH = "{YREC_INPUT}/eos/scv/h_tab_i.dat" ! SCZ EoS table for X
 FSCVHE = "{YREC_INPUT}/eos/scv/he_tab_i.dat" ! SCZ EoS table for Y
 FSCVZ = "{YREC_INPUT}/eos/scv/z_tab_i.dat" ! SCZ EoS table for Z (generated from YREC EoS, needed for consistency)
 FFERMI = "{YREC_INPUT}/eos/yale/FERMI.TAB" ! Fermi integral tables for partial degeracy
  
 $END  
